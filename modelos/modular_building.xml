<mujoco model="14_modular_building">
  <!--
    ========================================
    MUNDO 14: CONSTRUCCIÓN MODULAR
    ========================================
    
    OBJETIVO: Demostrar diseño modular y reutilizable
    
    CONCEPTOS:
    - Organización del código XML por secciones
    - Uso de <body> para agrupar elementos relacionados
    - Patrones reusables mediante comentarios claros
    - Buenas prácticas de nomenclatura
    - Documentación interna del diseño
    
    ESTRUCTURA:
    - Este mundo muestra cómo organizar escenarios complejos
    - Cada "módulo" (habitación, pasillo) está claramente delimitado
    - Los patrones pueden copiarse para expandir el mundo
    
    NOTA: En MJCF no hay templates reales, pero una buena
    organización facilita copy-paste de módulos completos
  -->

  <include file="g1.xml"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.2 0.2 0.2" specular="0.8 0.8 0.8"/>
    <global azimuth="160" elevation="-25"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0.1 0.1 0.15" width="512" height="3072"/>
    
    <!-- LIBRERÍA DE TEXTURAS REUTILIZABLES -->
    <texture type="2d" name="floor_tile" builtin="checker" 
             rgb1="0.35 0.35 0.4" rgb2="0.4 0.4 0.45" width="300" height="300"/>
    <texture type="2d" name="wall_concrete" builtin="flat" 
             rgb1="0.65 0.65 0.68" width="200" height="200"/>
    <texture type="2d" name="wood_texture" builtin="flat" 
             rgb1="0.45 0.3 0.2" width="150" height="150"/>
    
    <!-- LIBRERÍA DE MATERIALES REUTILIZABLES -->
    <material name="floor_mat" texture="floor_tile" texuniform="true" texrepeat="10 10" reflectance="0.1"/>
    <material name="wall_mat" texture="wall_concrete" reflectance="0.05"/>
    <material name="wood_mat" texture="wood_texture" reflectance="0.15"/>
  </asset>

  <worldbody>
    <!-- ======================================== -->
    <!-- SISTEMA DE ILUMINACIÓN -->
    <!-- ======================================== -->
    
    <light name="main_ceiling_1" pos="-5 0 2.8" diffuse="0.7 0.7 0.7" castshadow="true"/>
    <light name="main_ceiling_2" pos="5 0 2.8" diffuse="0.7 0.7 0.7" castshadow="true"/>
    <light name="corridor_light" pos="0 5 2.8" diffuse="0.6 0.6 0.6" castshadow="false"/>
    <light name="ambient_fill" directional="true" pos="0 0 8" dir="0 0 -1" diffuse="0.3 0.3 0.3"/>
    
    <!-- ======================================== -->
    <!-- SUELO BASE -->
    <!-- ======================================== -->
    
    <geom name="floor_base" type="plane" size="0 0 0.05" material="floor_mat" friction="1 0.005 0.0001"/>
    
    <!-- ======================================== -->
    <!-- MÓDULO 1: HABITACIÓN OESTE -->
    <!-- ======================================== -->
    <!-- Patrón reusable: habitación de 6x6m con 4 paredes -->
    
    <!-- Paredes habitación oeste -->
    <geom name="room1_wall_north" type="box" pos="-5 3 1.4" size="3 0.15 1.4" material="wall_mat"/>
    <geom name="room1_wall_south" type="box" pos="-5 -3 1.4" size="3 0.15 1.4" material="wall_mat"/>
    <geom name="room1_wall_west" type="box" pos="-8 0 1.4" size="0.15 3 1.4" material="wall_mat"/>
    <geom name="room1_wall_east_partial_1" type="box" pos="-2 0 1.4" size="0.15 1.2 1.4" material="wall_mat"/>
    
    <!-- Puerta (espacio vacío en pared este) -->
    <!-- No-geom entre -2, -1.2 y -2, 1.2 en eje Y (puerta de ~2.4m) -->
    
    <!-- Contenido habitación oeste -->
    <geom name="room1_table" type="box" pos="-6 1.5 0.7" size="0.5 0.4 0.04" material="wood_mat"/>
    <geom name="room1_chair" type="box" pos="-5 1.5 0.45" size="0.25 0.25 0.03" material="wood_mat"/>
    
    <!-- ======================================== -->
    <!-- MÓDULO 2: PASILLO CENTRAL -->
    <!-- ======================================== -->
    <!-- Patrón reusable: corredor de conexión -->
    
    <!-- Paredes del pasillo -->
    <geom name="corridor_wall_north" type="box" pos="0 5 1.4" size="5 0.15 1.4" material="wall_mat"/>
    <geom name="corridor_wall_south" type="box" pos="0 -5 1.4" size="5 0.15 1.4" material="wall_mat"/>
    
    <!-- Marcas en el suelo del pasillo -->
    <geom name="corridor_stripe_1" type="box" pos="0 0 0.005" size="5 0.1 0.005" rgba="0.8 0.8 0.2 0.8"/>
    
    <!-- ======================================== -->
    <!-- MÓDULO 3: HABITACIÓN ESTE -->
    <!-- ======================================== -->
    <!-- Mismo patrón que habitación oeste, diferente contenido -->
    
    <!-- Paredes habitación este -->
    <geom name="room2_wall_north" type="box" pos="5 3 1.4" size="3 0.15 1.4" material="wall_mat"/>
    <geom name="room2_wall_south" type="box" pos="5 -3 1.4" size="3 0.15 1.4" material="wall_mat"/>
    <geom name="room2_wall_east" type="box" pos="8 0 1.4" size="0.15 3 1.4" material="wall_mat"/>
    <geom name="room2_wall_west_partial" type="box" pos="2 0 1.4" size="0.15 1.2 1.4" material="wall_mat"/>
    
    <!-- Contenido habitación este: obstáculos para navegación -->
    <geom name="room2_obstacle_1" type="box" pos="5 1.5 0.3" size="0.4 0.4 0.3" rgba="0.6 0.3 0.3 1"/>
    <geom name="room2_obstacle_2" type="cylinder" pos="6 -1.5 0.4" size="0.3 0.4" rgba="0.3 0.6 0.3 1"/>
    <geom name="room2_obstacle_3" type="sphere" pos="4 -1.5 0.35" size="0.35" rgba="0.3 0.3 0.6 1"/>
    
    <!-- ======================================== -->
    <!-- MÓDULO 4: ZONA NORTE (ESCALERAS) -->
    <!-- ======================================== -->
    <!-- Patrón reusable: transición de nivel -->
    
    <!-- Escalones hacia zona elevada -->
    <geom name="north_step_1" type="box" pos="0 8 0.12" size="2 0.15 0.12" rgba="0.5 0.5 0.55 1"/>
    <geom name="north_step_2" type="box" pos="0 8.3 0.36" size="2 0.15 0.12" rgba="0.5 0.5 0.55 1"/>
    <geom name="north_step_3" type="box" pos="0 8.6 0.6" size="2 0.15 0.12" rgba="0.5 0.5 0.55 1"/>
    
    <!-- Plataforma elevada -->
    <geom name="north_platform" type="box" pos="0 10 0.72" size="2 1.5 0.05" rgba="0.55 0.55 0.6 1"/>
    
    <!-- ======================================== -->
    <!-- ELEMENTOS DECORATIVOS COMPARTIDOS -->
    <!-- ======================================== -->
    
    <!-- Marcadores de spawn points (útil para debug) -->
    <geom name="spawn_west" type="cylinder" pos="-5 0 0.02" size="0.3 0.02" rgba="0 1 0 0.3" contype="0" conaffinity="0"/>
    <geom name="spawn_corridor" type="cylinder" pos="0 0 0.02" size="0.3 0.02" rgba="0 1 0 0.3" contype="0" conaffinity="0"/>
    <geom name="spawn_east" type="cylinder" pos="5 0 0.02" size="0.3 0.02" rgba="0 1 0 0.3" contype="0" conaffinity="0"/>
    
    <!-- ======================================== -->
    <!-- SISTEMA DE CÁMARAS -->
    <!-- ======================================== -->
    
    <camera name="overview_top" pos="0 0 15" xyaxes="1 0 0 0 1 0" mode="fixed"/>
    <camera name="overview_angle" pos="-8 -12 8" xyaxes="0.6 0.8 0 -0.4 0.3 1" mode="fixed"/>
    <camera name="room_west" pos="-5 -6 2" xyaxes="1 0 0 0 0.7 1" mode="fixed"/>
    <camera name="corridor_view" pos="0 -8 3" xyaxes="1 0 0 0 0.6 1" mode="fixed"/>
    <camera name="room_east" pos="5 -6 2" xyaxes="1 0 0 0 0.7 1" mode="fixed"/>
  </worldbody>

  <!--
    ========================================
    GUÍA DE REUTILIZACIÓN
    ========================================
    
    Para expandir este mundo:
    
    1. AÑADIR NUEVA HABITACIÓN:
       - Copiar bloque completo de "MÓDULO 1" o "MÓDULO 3"
       - Cambiar nombres (room3_...)
       - Ajustar posiciones (pos)
       - Modificar contenido según necesidad
    
    2. AÑADIR NUEVO PASILLO:
       - Copiar bloque de "MÓDULO 2"
       - Cambiar orientación si es necesario (intercambiar X/Y en size y pos)
       - Ajustar longitud modificando size
    
    3. AÑADIR ESCALERAS/RAMPA:
       - Copiar bloque de "MÓDULO 4"
       - Ajustar número de escalones
       - Cambiar posiciones según diseño
    
    4. MEJORES PRÁCTICAS:
       - Usar nomenclatura consistente (module_element_number)
       - Comentar cada sección claramente
       - Agrupar elementos relacionados
       - Documentar dimensiones estándar
       - Mantener patrones consistentes
    
    DIMENSIONES ESTÁNDAR USADAS:
    - Habitación: 6m x 6m x 2.8m
    - Pasillo: 10m x 2m x 2.8m
    - Puerta: 2.4m ancho
    - Escalón: 30cm profundo x 24cm alto
    - Grosor pared: 0.3m (0.15m size)
  -->

</mujoco>
