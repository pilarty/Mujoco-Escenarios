<mujocoinclude>
  <asset>
    <mesh name="mesh_estructura" file="../../escenarios/habitacion_post_sismo_01/meshes/habitacion_post_sismo_01_estructura.obj" scale="1 1 1"/>

    <texture name="tex_estructura" type="2d" file="../../escenarios/habitacion_post_sismo_01/meshes/texture_pbr_20250901.png"/>
    <material name="mat_estructura" texture="tex_estructura"/>

    <!--
      Acá se van a ir agregando los .obj de daños que mande el usuario,
      cada uno como su propio <mesh> (y su <material>/<texture> si
      corresponde). Ejemplo:
      <mesh name="mesh_nombre_dano" file="../../escenarios/habitacion_post_sismo_01/meshes/nombre_dano.obj" scale="1 1 1"/>
      <material name="mat_nombre_dano" rgba="R G B 1"/>
    -->
  </asset>

  <worldbody>
    <body name="objeto_dañado" pos="0 0 0" euler="0 0 0">
      <geom name="geom_estructura" type="mesh" mesh="mesh_estructura" material="mat_estructura" contype="0" conaffinity="0"/>

      <!--
        Y acá el <geom> correspondiente a cada mesh de daño agregada
        arriba, con su propio pos/euler relativo a este body si hace
        falta reubicarla. Ejemplo:
        <geom name="geom_nombre_dano" type="mesh" mesh="mesh_nombre_dano" material="mat_nombre_dano" contype="0" conaffinity="0"/>
      -->
    </body>
  </worldbody>
</mujocoinclude>
