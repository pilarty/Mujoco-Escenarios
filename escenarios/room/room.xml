<mujoco model="13_room_furnished">
  <!--
    ========================================
    MUNDO 13: HABITACIÓN AMUEBLADA
    ========================================
    
    OBJETIVO: Integración de todos los conceptos aprendidos
    
    ELEMENTOS:
    - Geometrías variadas (cajas, cilindros, esferas)
    - Materiales y texturas
    - Fricción apropiada
    - Iluminación realista
    - Composición de "muebles" con múltiples geoms
    
    MUEBLES SIMULADOS:
    - Mesa con patas
    - Estantería
    - Silla simple
    - Objetos decorativos
  -->

  <include file="g1.xml"/>

  <visual>
    <headlight diffuse="0.4 0.4 0.4" ambient="0.2 0.2 0.2" specular="0.8 0.8 0.8"/>
    <global azimuth="140" elevation="-20"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0.1 0.1 0.15" width="512" height="3072"/>
    
    <!-- Texturas -->
    <texture type="2d" name="floor_wood" builtin="checker" 
             rgb1="0.5 0.35 0.2" rgb2="0.55 0.4 0.25" width="300" height="300"/>
    <texture type="2d" name="wall_paint" builtin="flat" 
             rgb1="0.85 0.82 0.75" width="200" height="200"/>
    <texture type="2d" name="wood_dark" builtin="flat" 
             rgb1="0.3 0.2 0.1" width="100" height="100"/>
    <texture type="2d" name="metal_tex" builtin="flat" 
             rgb1="0.6 0.6 0.65" width="100" height="100"/>
    
    <!-- Materiales -->
    <material name="floor_mat" texture="floor_wood" texuniform="true" texrepeat="6 6" reflectance="0.2"/>
    <material name="wall_mat" texture="wall_paint" reflectance="0.05"/>
    <material name="wood_mat" texture="wood_dark" reflectance="0.15"/>
    <material name="metal_mat" texture="metal_tex" reflectance="0.6" specular="0.9" shininess="0.8"/>
  </asset>

  <worldbody>
    <!-- Iluminación -->
    <light name="ceiling_main" pos="0 0 2.7" diffuse="0.9 0.9 0.85" castshadow="true"/>
    <light name="window_sim" directional="true" pos="4 0 2" dir="-1 0 -0.5" diffuse="0.4 0.45 0.5"/>
    <light name="ambient" directional="true" pos="0 0 5" dir="0 0 -1" diffuse="0.2 0.2 0.2"/>
    
    <!-- Suelo -->
    <geom name="floor" type="plane" size="0 0 0.05" material="floor_mat" friction="1 0.005 0.0001"/>
    
    <!-- ======================================== -->
    <!-- PAREDES -->
    <!-- ======================================== -->
    
    <geom name="wall_north" type="box" pos="0 4 1.4" size="4 0.15 1.4" material="wall_mat"/>
    <geom name="wall_south" type="box" pos="0 -4 1.4" size="4 0.15 1.4" material="wall_mat"/>
    <geom name="wall_east" type="box" pos="4 0 1.4" size="0.15 4 1.4" material="wall_mat"/>
    <geom name="wall_west" type="box" pos="-4 0 1.4" size="0.15 4 1.4" material="wall_mat"/>
    
    <!-- ======================================== -->
    <!-- MUEBLE 1: MESA CON PATAS -->
    <!-- ======================================== -->
    
    <!-- Superficie de la mesa -->
    <geom name="table_top" type="box" pos="2 2 0.7" size="0.6 0.5 0.04" material="wood_mat"/>
    
    <!-- Patas de la mesa -->
    <geom name="table_leg_1" type="cylinder" pos="1.5 1.6 0.35" size="0.04 0.35" material="wood_mat"/>
    <geom name="table_leg_2" type="cylinder" pos="2.5 1.6 0.35" size="0.04 0.35" material="wood_mat"/>
    <geom name="table_leg_3" type="cylinder" pos="1.5 2.4 0.35" size="0.04 0.35" material="wood_mat"/>
    <geom name="table_leg_4" type="cylinder" pos="2.5 2.4 0.35" size="0.04 0.35" material="wood_mat"/>
    
    <!-- Objeto sobre la mesa -->
    <geom name="table_object" type="sphere" pos="2 2 0.82" size="0.08" rgba="0.8 0.3 0.3 1"/>
    
    <!-- ======================================== -->
    <!-- MUEBLE 2: ESTANTERÍA -->
    <!-- ======================================== -->
    
    <!-- Paneles verticales -->
    <geom name="shelf_left" type="box" pos="-3 3 0.8" size="0.03 0.4 0.8" material="wood_mat"/>
    <geom name="shelf_right" type="box" pos="-2 3 0.8" size="0.03 0.4 0.8" material="wood_mat"/>
    <geom name="shelf_back" type="box" pos="-2.5 3.37 0.8" size="0.5 0.03 0.8" material="wood_mat"/>
    
    <!-- Estantes horizontales -->
    <geom name="shelf_1" type="box" pos="-2.5 3 0.5" size="0.47 0.37 0.02" material="wood_mat"/>
    <geom name="shelf_2" type="box" pos="-2.5 3 1.0" size="0.47 0.37 0.02" material="wood_mat"/>
    <geom name="shelf_3" type="box" pos="-2.5 3 1.5" size="0.47 0.37 0.02" material="wood_mat"/>
    
    <!-- Objetos en estantes -->
    <geom name="shelf_item_1" type="box" pos="-2.7 3 0.58" size="0.08 0.08 0.06" rgba="0.4 0.6 0.8 1"/>
    <geom name="shelf_item_2" type="cylinder" pos="-2.3 3 0.58" size="0.06 0.08" rgba="0.6 0.8 0.4 1"/>
    <geom name="shelf_item_3" type="sphere" pos="-2.5 3 1.1" size="0.07" rgba="0.8 0.6 0.4 1"/>
    
    <!-- ======================================== -->
    <!-- MUEBLE 3: SILLA SIMPLE -->
    <!-- ======================================== -->
    
    <!-- Asiento -->
    <geom name="chair_seat" type="box" pos="-2 -2 0.45" size="0.25 0.25 0.03" material="wood_mat"/>
    
    <!-- Patas -->
    <geom name="chair_leg_1" type="cylinder" pos="-2.2 -2.2 0.225" size="0.03 0.225" material="wood_mat"/>
    <geom name="chair_leg_2" type="cylinder" pos="-1.8 -2.2 0.225" size="0.03 0.225" material="wood_mat"/>
    <geom name="chair_leg_3" type="cylinder" pos="-2.2 -1.8 0.225" size="0.03 0.225" material="wood_mat"/>
    <geom name="chair_leg_4" type="cylinder" pos="-1.8 -1.8 0.225" size="0.03 0.225" material="wood_mat"/>
    
    <!-- Respaldo -->
    <geom name="chair_back" type="box" pos="-2 -2.23 0.75" size="0.25 0.03 0.3" material="wood_mat"/>
    
    <!-- ======================================== -->
    <!-- DECORACIÓN -->
    <!-- ======================================== -->
    
    <!-- Lámpara de pie simulada -->
    <geom name="lamp_pole" type="cylinder" pos="3 -3 0.8" size="0.03 0.8" material="metal_mat"/>
    <geom name="lamp_shade" type="capsule" pos="3 -3 1.65" size="0.15 0.1" rgba="0.9 0.9 0.7 0.6"/>
    
    <!-- Alfombra (área con fricción diferente) -->
    <geom name="rug" type="box" pos="0 -1 0.005" size="1.2 0.8 0.005" rgba="0.6 0.3 0.2 1" friction="0.8 0.005 0.0001"/>
    
    <!-- Cuadro en pared (plano) -->
    <geom name="wall_art" type="box" pos="-3.95 0 1.5" size="0.02 0.3 0.4" rgba="0.3 0.4 0.6 1"/>
    
    <!-- Planta decorativa -->
    <geom name="plant_pot" type="cylinder" pos="3.5 3.5 0.15" size="0.15 0.15" rgba="0.6 0.4 0.3 1"/>
    <geom name="plant_stem" type="capsule" pos="3.5 3.5 0.4" size="0.02 0.25" rgba="0.2 0.6 0.2 1"/>
    <geom name="plant_top" type="sphere" pos="3.5 3.5 0.7" size="0.12" rgba="0.3 0.7 0.3 1"/>
    
    <!-- ======================================== -->
    <!-- CÁMARAS -->
    <!-- ======================================== -->
    
    <camera name="room_overview" pos="5 -5 4" xyaxes="0.7 0.7 0 -0.3 0.3 1" mode="fixed"/>
    <camera name="room_corner" pos="-5 -5 3" xyaxes="0.7 0.7 0 -0.3 0.3 1" mode="fixed"/>
    <camera name="room_inside" pos="0 0 1.6" xyaxes="1 0 0 0 0 1" mode="fixed"/>
    <camera name="table_view" pos="2 0 1.2" xyaxes="0 1 0 0 0 1" mode="fixed"/>
  </worldbody>

</mujoco>
